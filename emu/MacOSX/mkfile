SYSTARG=MacOSX
OBJTYPE=arm64
# Bypass mkconfig - it causes wrong platform flags
# Include platform-specific files directly:
SHELLTYPE=sh
OBJDIR=$SYSTARG/$OBJTYPE
<../../mkfiles/mkhost-$SYSTARG
<../../mkfiles/mkfile-$SYSTARG-$OBJTYPE

#Configurable parameters

CONF=emu			#default configuration
CONFLIST=emu
CLEANCONFLIST=

# GUI Backend Selection
# Options: headless, sdl3
# Default: headless (no display, terminal only)
GUIBACK=sdl3

INSTALLDIR=$ROOT/$SYSTARG/$OBJTYPE/bin	#path of directory where kernel is installed

#end configurable parameters

<| AWK=$AWK sh ../port/mkdevlist < $CONF	#sets $IP, $DEVS, $PORT, $LIBS

# Include GUI backend configuration
<mkfile-gui-$GUIBACK

OBJ=\
	asm-$OBJTYPE.$O\
	os.$O\
	memhw.$O\
	memhw-metal.$O\
	$GUISRC\
	$CONF.root.$O\
	lock.$O\
	$DEVS\
	$PORT\

HFILES=\

CFLAGS=\
	'''-DROOT="'.'"'''\
	-DEMU -I. -I../port\
	-I../../$SYSTARG/$OBJTYPE/include\
	-I../../include\
	-I../../libinterp\
	$CTHREADFLAGS $CFLAGS $EMUOPTIONS $GUIFLAGS\

KERNDATE=0

SYSLIBS= \
	-lm\
	-lpthread\
	-framework CoreFoundation\
	-framework IOKit\
	-framework Metal\
	-framework Foundation\

default:V:	$O.$CONF


# NB $LIBFILES in the prerequisites is load-bearing: without it the
# emu never relinks after a library rebuild (libtk.a etc.) and every
# engine change silently ships stale — "I rebuilt and nothing changed".
$O.$CONF:	$OBJ $CONF.c $CONF.root.h $LIBFILES
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD $LDFLAGS -o $target $OBJ $CONF.$O $LIBFILES $SYSLIBS $GUILIBS

install:V: $O.$CONF
	cp $O.$CONF $INSTALLDIR/$CONF

<../port/portmkfile

# the GPU as drawing hardware: Objective-C, apart from Inferno's headers
memhw-metal.$O:	memhw-metal.m memhw-metal.h
	$CC -fobjc-arc $CFLAGS memhw-metal.m

memhw.$O:	memhw-metal.h

ipif.c:N:	../FreeBSD/ipif.c
devfs.c:N:	../port/devfs-posix.c
