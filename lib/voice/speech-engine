# speech-engine — topology 2 engine role: import the terminal's /dev,
# run speechshim9p against its audio, and export the provider contract.
#
# Usage:
#   sh /lib/voice/speech-engine tcp!terminal!17010 [provider-port] [terminal-mount] [provider-mount] [mount-attempts] [state-file]

load std
load expr

terminal=$1
providerport=$2
termmnt=$3
provider=$4
mounttries=$5
statefile=$6
if {~ $#terminal 0} {
	echo 'usage: voice/speech-engine terminal-audio-addr [provider-port] [terminal-mount] [provider-mount]' >[1=2]
	exit usage
}
if {~ $#providerport 0} {
	providerport=17019
}
if {~ $#termmnt 0} {
	termmnt=/n/term
}
if {~ $#provider 0} {
	provider=/n/speechengine
}
if {~ $#mounttries 0} {
	mounttries=30
}
if {~ $#statefile 0} {
	statefile=/tmp/speech-engine.state
}

fn setstate {
	rm -f $statefile
	echo $* > $statefile
}

shim_pid=

fn cleanupengine {
	if {! ~ $#shim_pid 0} {
		if {ftest -e /prog/$shim_pid} {
			echo killgrp >/prog/$shim_pid/ctl
		}
	}
	unmount $provider >[2] /dev/null
	unmount $termmnt >[2] /dev/null
}

# Keep redirection-open errors inside a child shell so a rejected provider ctl
# becomes a normal failure result instead of aborting the launcher.
fn writectl {
	ctlvalue=$1
	ctlpath=$2
	sh -c 'echo $ctlvalue > $ctlpath'
}

fn routeengine {
	result=configured
	if {! writectl 'audiodev '^$termmnt'/audio' $provider/ctl} {
		result=$provider/ctl
	}
	if {~ $result configured} {
		if {! writectl 'capturedev default' $provider/ctl} {
			result=$provider/ctl
		}
	}
	if {~ $result configured} {
		if {! writectl 'micmode device' $provider/ctl} {
			result=$provider/ctl
		}
	}
	if {~ $result configured} {
		if {! writectl 'duplex half' $provider/ctl} {
			result=$provider/ctl
		}
	}
}

setstate starting terminal $terminal

mkdir -p $termmnt
tries=0
while {! mount -A $terminal $termmnt} {
	tries=${expr $tries 1 +}
	setstate waiting terminal $terminal attempt $tries^/$mounttries
	if {~ $tries $mounttries} {
		echo 'voice/speech-engine: terminal audio mount failed:' $terminal >[1=2]
		setstate failed terminal $terminal
		cleanupengine
		exit mount
	}
	sleep 1
}
if {! ftest -e $termmnt/audio} {
	echo 'voice/speech-engine: terminal audio mount failed:' $terminal >[1=2]
	cleanupengine
	setstate failed audio $termmnt'/audio'
	exit mount
}

mkdir -p $provider
# Keep a group leader alive so cleanup can stop speechshim9p and all of its
# Styx workers even after the launcher process itself has been replaced.
{pctl newpgrp; /dis/veltro/speechshim9p.dis -m $provider &; sleep 99999} &
shim_pid=$apid
sleep 1
if {! ftest -e $provider/ctl} {
	echo 'voice/speech-engine: speechshim9p did not mount at' $provider >[1=2]
	cleanupengine
	setstate failed shim $provider
	exit shim
}

routeengine
if {! ~ $result configured} {
	echo 'voice/speech-engine: speech routing failed:' $result >[1=2]
	cleanupengine
	setstate failed control $result
	exit ctl
}

addr='tcp!*!'$providerport
setstate connected terminal $terminal exporting $addr
echo 'voice/speech-engine:' $addr 'exporting' $provider
listen -As $addr {
	export $provider
}
cleanupengine
setstate failed provider listener $addr
exit listen
