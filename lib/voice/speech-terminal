# speech-terminal — topology 2 terminal role: export this machine's audio,
# mount a remote speech provider, and select it for /n/speech.
#
# Usage:
#   sh /lib/voice/speech-terminal tcp!engine!17019 [audio-port] [provider-mount] [mount-attempts] [state-file]

load std
load expr

engine=$1
audioport=$2
provider=$3
mounttries=$4
statefile=$5
if {~ $#engine 0} {
	echo 'usage: voice/speech-terminal engine-provider-addr [audio-port] [provider-mount]' >[1=2]
	exit usage
}
if {~ $#audioport 0} {
	audioport=17010
}
if {~ $#provider 0} {
	provider=/n/remotespeech
}
if {~ $#mounttries 0} {
	mounttries=30
}
if {~ $#statefile 0} {
	statefile=/tmp/speech-terminal.state
}

fn setstate {
	rm -f $statefile
	echo $* > $statefile
}

fn mountprovider {
	tries=0
	result=retry
	while {~ $result retry} {
		if {mount -A $engine $provider} {
			result=mounted
		} {
			tries=${expr $tries 1 +}
			setstate waiting provider $engine attempt $tries^/$mounttries
			if {~ $tries $mounttries} {
				result=failed
			}
			if {~ $result retry} {
				sleep 1
			}
		}
	}
}

fn watchprovider {
	while {~ 1 1} {
		sleep 1
		if {! cat $provider/ctl > /dev/null} {
			setstate disconnected provider $engine
			unmount $provider >[2] /dev/null
			mountprovider
			if {~ $result mounted} {
				echo 'provider '$provider > /n/speech/ctl
				echo 'duplex half' > /n/speech/ctl
				setstate connected provider $engine
			} {
				setstate failed provider $engine
				exit mount
			}
		}
	}
}

setstate starting provider $engine

# voice/listen owns the devaudio bind, buffer caps, pre-warm, and export loop.
sh /lib/voice/listen $audioport &
terminal_pid=$apid
sleep 1

mkdir -p $provider
mountprovider
if {! ~ $result mounted} {
	echo 'voice/speech-terminal: provider mount failed:' $engine >[1=2]
	setstate failed provider $engine
	if {ftest -e /prog/$terminal_pid} {
		echo kill >/prog/$terminal_pid/ctl
	}
	exit mount
}

echo 'provider '$provider > /n/speech/ctl
echo 'duplex half' > /n/speech/ctl
setstate connected provider $engine
watchprovider &
watch_pid=$apid
echo 'voice/speech-terminal: audio tcp!*!'$audioport 'provider' $provider
echo '  listener pid=' $terminal_pid
echo '  recovery pid=' $watch_pid 'state=' $statefile
